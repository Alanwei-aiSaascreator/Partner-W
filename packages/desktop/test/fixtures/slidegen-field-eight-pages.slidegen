    <Box style={{ flexDirection: 'column', gap: 16 }}>
      {[
        ['身份', '个人智能助手'],
        ['运行平台', 'OpenClaw'],
        ['特点', '有性格，不是工具人'],
        ['记忆方式', '文件，不是数据库'],
      ].map(([k, v], i) => (
        <Box key={i} style={{ flexDirection: 'row', justifyContent: 'space-between', borderBottom: '1px solid rgba(168,85,247,0.1)', paddingBottom: 12 }}>
          <Text style={{ fontSize: 14, color: C.dim }}>{k}</Text>
          <Text style={{ fontSize: 14, color: C.text, fontWeight: 500 }}>{v}</Text>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>

