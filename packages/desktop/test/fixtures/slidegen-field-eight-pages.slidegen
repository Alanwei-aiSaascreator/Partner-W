// title: 认识我 - OpenClaw 助手

const C = {
  bg: '#0F0A1A',
  card: '#1A1230',
  text: '#F0EDF6',
  dim: '#8B83A3',
  accent: '#A855F7',
  accent2: '#EC4899',
  grad: 'linear-gradient(135deg, #A855F7 0%, #EC4899 50%, #F97316 100%)',
  grad2: 'linear-gradient(135deg, #7C3AED 0%, #DB2777 100%)',
  border: '1px solid rgba(168, 85, 247, 0.2)',
}

// ========== 封面 ==========
<Slide style={{ width: 1280, height: 720, background: C.bg, position: 'relative', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
