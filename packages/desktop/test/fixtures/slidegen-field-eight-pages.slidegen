  <Box style={{ position: 'absolute', width: 600, height: 600, borderRadius: 300, background: 'radial-gradient(circle, rgba(168,85,247,0.12) 0%, transparent 70%)', left: -100, top: -120 }} />
  <Box style={{ position: 'absolute', width: 500, height: 500, borderRadius: 250, background: 'radial-gradient(circle, rgba(236,72,153,0.08) 0%, transparent 70%)', right: -80, bottom: -100 }} />

  <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 20, zIndex: 1 }}>
