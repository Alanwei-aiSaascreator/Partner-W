      ['专业分工', '六位助手各司其职，深度覆盖不同领域'],
      ['统一平台', '不需要在多个 AI 工具之间来回切换'],
      ['持续进化', '知识库和技能随使用不断更新完善'],
    ].map(([t, d], i) => (
      <Box key={i} style={{ flexDirection: 'row', gap: 16, padding: '14px 20px', borderRadius: 10, background: C.white, border: `1px solid ${C.cardBorder}` }}>
        <Box style={{ minWidth: 32, height: 32, borderRadius: 16, background: C.primaryLight, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: C.primary }}>{i + 1}</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 2 }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: C.text }}>{t}</Text>
