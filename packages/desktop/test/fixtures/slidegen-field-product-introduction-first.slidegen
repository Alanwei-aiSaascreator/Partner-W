// ════════════════════════ 第 11 页：适用场景 ════════════════════════
<Slide style={{ width: 1280, height: 720, background: C.bg, position: 'relative' }}>
  <PageTitle sub="从个人创作者到运营团队，你都可以立刻上手">
    谁在使用荣盈魔方
  </PageTitle>
  <Box style={{ position: 'absolute', left: 80, top: 180, width: 1120, flexDirection: 'row', gap: 24 }}>
    {[
      {
        role: '内容创作者',
        color: C.primary,
        cases: [
          '公众号 / 小红书日更',
          '短视频脚本批量产出',
          '多平台内容分发',
        ],
      },
      {
        role: '电商运营',
        color: '#06B6D4',
        cases: [
          '商品页优化与 A/B 测试',
          '客户消息批量回复',
          '促销活动策划',
        ],
      },
      {
        role: '上班族 / 管理者',
        color: '#F59E0B',
        cases: [
          '会议纪要与周报',
          '调研报告与方案',
          '正式邮件与通知',
        ],
      },
      {
        role: '个体 / 家庭',
        color: '#10B981',
        cases: [
          '旅行计划与菜谱',
          '家庭活动安排',
          '学习与知识整理',
        ],
      },
    ].map(({ role, color, cases }, i) => (
      <Box key={i} style={{ flex: 1, flexDirection: 'column', gap: 14, padding: '24px', borderRadius: 14, background: C.white, border: `1px solid ${C.cardBorder}` }}>
        <Box style={{ width: 48, height: 48, borderRadius: 12, background: color + '18', alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 22, color: color }}>{['✎', '☰', '▤', '♡'][i]}</Text>
        </Box>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: C.text }}>{role}</Text>
        {cases.map((c, j) => (
          <Box key={j} style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
            <Text style={{ fontSize: 14, color: color, fontWeight: 'bold' }}>▸</Text>
            <Text style={{ fontSize: 15, color: C.muted }}>{c}</Text>
          </Box>
        ))}
      </Box>
    ))}
  </Box>
  <Footer />
</Slide>

// ════════════════════════ 第 12 页：尾页 ════════════════════════
