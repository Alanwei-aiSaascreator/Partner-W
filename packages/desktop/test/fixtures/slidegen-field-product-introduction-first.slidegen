// title: 荣盈魔方产品介绍

const C = {
  dark: '#1E1B4B',
  primary: '#4F46E5',
  primaryLight: '#EEF2FF',
  violet: '#7C3AED',
  bg: '#F8FAFC',
  text: '#1E293B',
  muted: '#64748B',
  white: '#FFFFFF',
  cardBorder: '#E2E8F0',
};

const Footer = () => (
  <Text style={{ position: 'absolute', left: 80, bottom: 30, width: 1120, fontSize: 13, color: C.muted, textAlign: 'center' }}>
    荣盈魔方 · 你的 AI 全能助手
  </Text>
);

const PageTitle = ({ children, sub }) => (
  <Box style={{ position: 'absolute', left: 80, top: 60, width: 1120, flexDirection: 'column', gap: 8 }}>
    <Text style={{ fontSize: 42, fontWeight: 'bold', color: C.text }}>{children}</Text>
    {sub && <Text style={{ fontSize: 20, color: C.muted, lineHeight: 1.5 }}>{sub}</Text>}
  </Box>
);

const CapCard = ({ title, desc, accent }) => (
  <Box style={{ width: 350, flexDirection: 'column', gap: 10, padding: '24px', borderRadius: 14, background: C.white, border: `1px solid ${C.cardBorder}` }}>
    <Box style={{ width: 40, height: 4, borderRadius: 2, background: accent || C.primary }} />
    <Text style={{ fontSize: 22, fontWeight: 'bold', color: C.text }}>{title}</Text>
    {desc.map((d, i) => (
      <Text key={i} style={{ fontSize: 15, color: C.muted, lineHeight: 1.5 }}>{d}</Text>
    ))}
  </Box>
);

const TwoCol = ({ left, leftChildren, right, rightChildren }) => (
  <Box style={{ position: 'absolute', left: 80, top: 170, width: 1120, flexDirection: 'row', gap: 40 }}>
    <Box style={{ width: 480, flexDirection: 'column', gap: 16 }}>
      {leftChildren}
    </Box>
    <Box style={{ width: 600, flexDirection: 'column', gap: 16 }}>
      {rightChildren}
    </Box>
  </Box>
);

const BulletItem = ({ icon, text, accent }) => (
  <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
    <Box style={{ minWidth: 28, height: 28, borderRadius: 14, background: accent || C.primaryLight, alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 14, fontWeight: 'bold', color: C.primary }}>{icon}</Text>
    </Box>
    <Text style={{ fontSize: 17, color: C.text, lineHeight: 1.5, flex: 1 }}>{text}</Text>
  </Box>
);

// ════════════════════════ 第 1 页：封面 ════════════════════════
<Slide style={{ width: 1280, height: 720, background: C.white, position: 'relative' }}>
  <Box style={{ position: 'absolute', left: 80, top: 0, width: 8, height: 720, background: `linear-gradient(180deg, ${C.primary} 0%, ${C.violet} 100%)` }} />
  <Box style={{ position: 'absolute', left: 140, top: 210, flexDirection: 'column', gap: 16 }}>
    <Text style={{ fontSize: 60, fontWeight: 'bold', color: C.dark, letterSpacing: 2 }}>
      荣盈魔方
    </Text>
    <Text style={{ fontSize: 28, color: C.muted, letterSpacing: 4 }}>
      你的 AI 全能助手
    </Text>
    <Box style={{ width: 80, height: 4, borderRadius: 2, background: C.primary, marginTop: 8 }} />
    <Text style={{ fontSize: 18, color: C.muted, lineHeight: 1.6, marginTop: 8 }}>
      一个平台 · 六面能力 · 像魔方一样，转出你需要的每一面
    </Text>
  </Box>
  {/* 右下方装饰 — 六个色块代表六面 */}
  <Box style={{ position: 'absolute', right: 80, bottom: 100, width: 120, height: 120, flexDirection: 'row', flexWrap: 'wrap', gap: 6 }}>
    {[C.primary, '#06B6D4', '#10B981', '#F59E0B', '#EF4444', C.violet].map((c, i) => (
      <Box key={i} style={{ width: 36, height: 36, borderRadius: 8, background: c, opacity: 0.3 }} />
    ))}
  </Box>
  <Footer />
</Slide>

// ════════════════════════ 第 2 页：什么是荣盈魔方 ════════════════════════
<Slide style={{ width: 1280, height: 720, background: C.bg, position: 'relative' }}>
