  "assistantWorkspaces": {
    "compass": {
      "description": "说出你想完成的事，或从下面选一个开始。",
      "starters": {
        "1": {
          "description": "拆解目标、步骤、时间与交付物",
          "prompt": "我想完成【目标】。请判断最合适的助手，补问必要条件，并给出可执行计划。",
          "title": "规划一项任务"
        },
        "2": {
          "description": "读取授权文件并归纳重点",
          "prompt": "请帮我整理电脑中的【文件或文件夹】。先说明需要我选择哪些资料，再按主题归纳重点和待办事项。",
          "title": "整理本机资料"
        },
        "3": {
          "description": "从成本、风险与效果给出建议",
          "prompt": "请比较【方案 A】和【方案 B】。从成本、效果、风险和适用条件分析，并给出明确建议。",
          "title": "比较多个方案"
        },
        "4": {
          "description": "把需求整理成文档、表格或清单",
          "prompt": "请把我的需求整理成一份可直接使用的【文档、表格或清单】。先确认交付格式和使用对象。",
          "title": "生成可用成果"
        }
      }
    },
    "content": {
      "description": "专注选题、文案和内容策划，把想法整理成可发布的内容。",
      "starters": {
        "1": {
          "description": "确定受众、角度和内容系列",
          "prompt": "围绕【主题】帮我策划选题。请先确认平台、受众和目标，再给出 10 个具体选题及推荐理由。",
          "title": "选题策划"
        },
        "2": {
          "description": "撰写图文、口播或社交媒体内容",
          "prompt": "请为【主题】写一篇【平台】文案。先确认受众、语气和篇幅，再交付可直接修改的初稿。",
          "title": "文案初稿"
        },
        "3": {
          "description": "优化结构、语气、标题和开头",
          "prompt": "请优化我提供的文案，保留事实和原意，重点改善标题、开头、结构与表达节奏。",
          "title": "改写优化"
        },
        "4": {
          "description": "安排周期、栏目和素材清单",
          "prompt": "请为【账号或品牌】制定一份【周期】内容日历，包括栏目、发布时间、素材需求和每条内容目标。",
          "title": "内容日历"
        }
      }
    },
    "ecommerce": {
      "description": "专注商品、店铺和转化问题，提供可落地的运营材料。",
      "starters": {
        "1": {
          "description": "提炼人群、痛点和差异化",
          "prompt": "请为【商品】提炼核心卖点。先确认目标人群、价格带和竞品，再输出分层卖点与证明材料。",
          "title": "商品卖点"
        },
        "2": {
          "description": "对比价格、内容和用户评价",
          "prompt": "请分析【竞品】。按定位、价格、卖点、页面内容和用户评价对比，并指出可利用的差异化机会。",
          "title": "竞品分析"
        },
        "3": {
          "description": "设计标题、卖点和转化结构",
          "prompt": "请为【商品】设计详情页文案结构，包括首屏标题、核心卖点、信任证明、场景和行动引导。",
          "title": "详情页文案"
        },
        "4": {
          "description": "覆盖售前、催付、异议和售后",
          "prompt": "请为【商品或店铺】整理客服话术，覆盖售前咨询、价格异议、催付、物流和售后场景。",
          "title": "客服话术"
        }
      }
    },
    "family": {
      "description": "处理家庭计划、生活安排与亲子事项，让日常事务更省心。",
      "starters": {
        "1": {
          "description": "结合人数、预算和采购清单",
          "prompt": "请按【人数、饮食偏好和预算】制定一周菜谱，并生成合并后的采购清单和备餐建议。",
          "title": "一周菜谱"
        },
        "2": {
          "description": "安排路线、时间、费用和备选方案",
          "prompt": "请规划一次【目的地】家庭出行。先确认成员、日期和预算，再给出行程、费用和雨天备选。",
          "title": "家庭出行"
        },
        "3": {
          "description": "提供年龄适配的材料和步骤",
          "prompt": "请为【孩子年龄】设计一项【时长】亲子活动，列出目标、材料、步骤和安全注意事项。",
          "title": "亲子活动"
        },
        "4": {
          "description": "整理分工、提醒和执行清单",
          "prompt": "请把【家庭事务】整理成可执行计划，明确时间、家庭成员分工、准备物品和提醒节点。",
          "title": "家庭计划"
        }
      }
    },
    "office": {
      "description": "专注文档、表格、会议和汇报，把资料变成可交付成果。",
      "starters": {
        "1": {
          "description": "从现有资料生成正式文档",
          "prompt": "请把我提供的资料整理成一份【文档类型】，先确认读者和用途，再输出清晰结构与正文初稿。",
          "title": "整理文档"
        },
        "2": {
          "description": "清洗、分析和汇总业务数据",
          "prompt": "请处理我提供的表格。先说明可读取的数据范围，再完成清洗、关键指标分析和汇总结论。",
          "title": "处理表格"
        },
        "3": {
          "description": "提取决策、责任人和截止时间",
          "prompt": "请把会议记录整理成纪要，分为结论、待办、责任人、截止时间和仍需确认的问题。",
          "title": "会议纪要"
        },
        "4": {
          "description": "构建提纲、要点和演示结构",
          "prompt": "请为【汇报主题】制作汇报提纲，明确听众、目标和时长，并给出逐页要点与数据需求。",
          "title": "汇报材料"
        }
      }
    },
    "research": {
      "description": "专注资料梳理、观点比较和学习计划，明确证据与未知项。",
      "starters": {
        "1": {
          "description": "整理来源、结论和不确定性",
          "prompt": "请调研【主题】。先确认范围和时效要求，再整理可靠来源、主要结论与尚不确定的问题。",
          "title": "快速调研"
        },
        "2": {
          "description": "比较证据、分歧和适用条件",
          "prompt": "请比较关于【问题】的不同观点，分别列出依据、争议点、适用条件和你的综合判断。",
          "title": "观点比较"
        },
        "3": {
          "description": "设置阶段目标、材料和练习",
          "prompt": "请为我制定【主题】学习计划。根据当前基础、可用时间和目标，安排阶段任务、资料与练习。",
          "title": "学习计划"
        },
        "4": {
          "description": "提炼概念、重点和行动建议",
          "prompt": "请总结我提供的资料，区分事实、作者观点和你的推断，并提炼核心概念、重点与行动建议。",
          "title": "资料总结"
        }
      }
    },
    "video": {
      "description": "专注拍摄脚本、分镜和剪辑方案，让创意直接进入制作。",
      "starters": {
        "1": {
          "description": "设计口播、画面和内容节奏",
          "prompt": "请为【主题】写一份【平台及时长】拍摄脚本，包括开头、口播、画面提示和行动引导。",
          "title": "拍摄脚本"
        },
        "2": {
          "description": "明确景别、机位、动作和时长",
          "prompt": "请把我提供的脚本拆成分镜表，列出镜号、景别、画面、台词、机位、时长和转场。",
          "title": "分镜设计"
        },
        "3": {
          "description": "整理场景、道具和拍摄顺序",
          "prompt": "请为【拍摄主题】生成镜头清单，按场景合并拍摄顺序，并列出人物、道具、设备和注意事项。",
          "title": "镜头清单"
        },
        "4": {
          "description": "规划结构、转场、字幕和配乐",
          "prompt": "请为【视频主题】制定剪辑方案，包括节奏结构、素材取舍、转场、字幕、音效和配乐建议。",
          "title": "剪辑方案"
        }
      }
    }
  },
